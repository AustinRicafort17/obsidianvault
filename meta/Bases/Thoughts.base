views:
  - type: cards
    name: Thoughts
    filters:
      and:
        - file.hasLink("01✍️NOTES/03 💭THOUGHTS.md")
        - "!created.isEmpty()"
    order:
      - file.name
      - file.mtime
    separator: ->
    indentProperties: true
    markers: bullet
    cardSize: 120
    image: note.cover
    imageAspectRatio: 1.2
