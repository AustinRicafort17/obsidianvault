properties:
  file.name:
    displayName: Date
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasLink("01✍️NOTES/05 ☀️ DAILY NOTES.md")
        - "!created.isEmpty()"
    order:
      - file.name
      - note.note
    sort:
      - property: file.mtime
        direction: DESC
    cardSize: 120
    image: note.cover
