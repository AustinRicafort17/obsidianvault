views:
  - type: cards
    name: Table
    filters:
      and:
        - file.hasLink("01✍️NOTES/04📚 LIBRARY.md")
        - "!Title.isEmpty()"
    groupBy:
      property: file.tags
      direction: ASC
    order:
      - file.name
      - rating
    cardSize: 120
    image: note.cover
    imageAspectRatio: 1.25
